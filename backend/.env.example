# PostgreSQL (locale sur le VPS via docker-compose, remplace l'ancienne base distante)
DATABASE_URL=postgresql://mrhonda:CHANGE_ME@db:5432/mrhonda

# Secrets JWT du backend mrhonda
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
MRHONDA_TOKEN_SECRET=replace-with-a-long-random-secret

CORS_ORIGINS=https://mr-honda.com,https://www.mr-honda.com

# Cloudinary (upload d'images depuis le dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# docker-compose uniquement
POSTGRES_PASSWORD=CHANGE_ME